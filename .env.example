# Local server port (must be reachable over LAN by your Roku device for mock/proxy tests)
PORT=4321
# Optional explicit LAN IPv4 override on multi-NIC / VPN machines (auto-detected if left empty)
LAN_HOST_IP=

# Physical Roku device settings (optional — SSDP discovery also works on the same subnet)
ROKU_IP=
ROKU_DEV_USER=rokudev
ROKU_DEV_PASSWORD=
