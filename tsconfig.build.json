{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/shared/**/*",
    "src/server/**/*",
    "src/cli/**/*",
    "src/mcp/**/*"
  ],
  "exclude": ["src/client/**/*", "tests/**/*"]
}
